# ==============================================================================
# Environment Configuration Template for Business Incubator DevOps Stack
# Copy to .env and configure values before starting the application.
# ==============================================================================

# Application Runtime Configuration
PORT=5000
NODE_ENV=production
CLIENT_ORIGIN=http://localhost:5000
FORCE_HTTPS=false
APP_IMAGE_TAG=latest

# Database Connection (In Docker Compose: 'mongo:27017', Locally: 'localhost:27017')
MONGODB_URI=mongodb://mongo:27017/business-incubator

# Authentication & Security Tokens
JWT_SECRET=production-secret-token-business-incubator-devops-2026
JWT_EXPIRE=7d
RESET_PASSWORD_EXPIRE_MINUTES=15

# Monitoring Credentials (Grafana)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Infrastructure Resource Naming
NETWORK_NAME=business-inc-net
MONGO_VOLUME_NAME=business_inc_mongo_data
PROMETHEUS_VOLUME_NAME=business_inc_prometheus_data
GRAFANA_VOLUME_NAME=business_inc_grafana_data
